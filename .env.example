# Copy this file to .env (root, for local tooling) and/or apps/web/.env.local and
# apps/worker/.env as appropriate. Never commit a file containing real values.
# See docs/ENVIRONMENT_VARIABLES.md for the full description of each variable.

# ---- Shared: database -------------------------------------------------------
# Direct Postgres connection string. Used by packages/db migrations, pg-boss, and
# the worker. For local dev this points at a Supabase CLI stack or any Postgres 15+.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ---- Shared: Supabase ---------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server/worker only. Bypasses Row-Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ---- Shared: app -------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development
# Server-only secret used to produce salted IP hashes for rate limiting/abuse logs.
IP_HASH_SALT=replace-with-a-long-random-string

# ---- apps/web: billing ---------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PRICE_ID_SOLO=price_replace
STRIPE_PRICE_ID_STUDIO=price_replace
STRIPE_PRICE_ID_AGENCY=price_replace

# ---- apps/web: free scan abuse controls --------------------------------------
FREE_SCAN_RATE_LIMIT_PER_IP_PER_DAY=3
FREE_SCAN_MAX_CONCURRENT=5

# ---- apps/worker: scheduling --------------------------------------------------
WORKER_CONCURRENCY=10
SCHEDULER_TICK_INTERVAL_SECONDS=30

# ---- apps/worker: safe-fetch ---------------------------------------------------
SAFE_FETCH_ALLOWED_PORTS=80,443
SAFE_FETCH_MAX_REDIRECTS=3
SAFE_FETCH_TIMEOUT_MS=10000
SAFE_FETCH_MAX_RESPONSE_BYTES=5242880

# ---- apps/worker: email --------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=care@example.com
RESEND_API_KEY=re_replace
# Only read when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ---- apps/worker: PDF rendering / storage --------------------------------------
PLAYWRIGHT_BROWSERS_PATH=0
REPORT_STORAGE_BUCKET=reports
